# Copy to `.env` and fill in values before `docker compose up`.
# CompreFace image versions: https://github.com/exadel-inc/CompreFace/releases

registry=exadel/
POSTGRES_VERSION=1.2.0
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0

postgres_username=compreface
postgres_password=change_me_postgres
postgres_db=compreface
postgres_domain=compreface-postgres-db
postgres_port=5432

enable_email_server=false
email_host=
email_username=
email_from=
email_password=

compreface_admin_java_options=-Xmx1g
compreface_api_java_options=-Xmx1g
save_images_to_db=true
max_file_size=10MB
max_request_size=10M
max_detect_size=1920
uwsgi_processes=1
uwsgi_threads=1
connection_timeout=10000
read_timeout=180000

# --- Apoyo verifier (set after CompreFace setup) ---
# 1. Fresh install includes a demo Verification service — API key:
#    00000000-0000-0000-0000-000000000004
#    Or open http://localhost:8000 → create account → add "Verification" service → copy API key
COMPREFACE_API_KEY=
COMPREFACE_API_URL=http://compreface-api:8080

# Shared secret between Supabase edge function and this service (generate a long random string)
FACE_VERIFY_SERVICE_KEY=

SIMILARITY_THRESHOLD=0.85
LIVENESS_MIN_FRAMES=4
FRAME_MIN_HAMMING_DISTANCE=2
ANTI_SPOOF_ENABLED=true
BLINK_REQUIRED=true
BLINK_MIN_EAR_DELTA=0.03

# Host port for verifier health/API (CompreFace UI stays on 8000)
VERIFIER_HOST_PORT=8090
