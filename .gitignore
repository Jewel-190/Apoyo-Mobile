# Recommended .gitignore for Expo / React Native projects
# Learn more: https://github.com/github/gitignore and https://docs.expo.dev

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo
.expo/
.expo-shared/
.expo/local/
expo-credentials.json

# Supabase local artifacts (never commit)
supabase/.temp/
supabase/.branches/
supabase/.cache/
supabase/.env
supabase/.env.*

# Build outputs
/android/**/build/
/ios/**/build/
android/app/build/
android/build/
ios/Pods/
ios/DerivedData/
web-build/
dist/

# Android local properties
android/local.properties

# Keystore / credentials (do not commit keys)
*.jks
*.keystore
*.p12
*.pem
*.p8

# Environment files
.env
.env.*
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo

# Metro bundler
.metro-cache/
.metro-health-check*

# Logs
*.log
logs/
.npm/_logs/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# macOS
.DS_Store
Icon?
Thumbs.db

# Coverage
coverage/
*.lcov
.nyc_output/

# Misc
.gradle/
build/
expo-env.d.ts

# Native folders are intentionally tracked in this repository.
